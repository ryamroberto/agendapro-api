# Configuracoes de Ambiente (AgendaPro API)

# Chave secreta do Django (em producao, gere uma chave forte e nunca exponha no Git)
SECRET_KEY=django-insecure-portfolio-dev-secret-key-change-in-production

# Modo de depuracao (True para desenvolvimento local, False para producao)
DEBUG=True

# Hosts permitidos separados por virgula (ex: localhost,127.0.0.1 ou seudominio.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Configuracoes opcionais de seguranca em producao (quando DEBUG=False)
# SECURE_SSL_REDIRECT=True
