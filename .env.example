# Configurações de Ambiente (Barber & Care)

# Chave secreta do Django (em produção, use uma chave forte e nunca exponha no Git)
SECRET_KEY=django-insecure-portfolio-dev-secret-key-change-in-production

# Modo de depuração (True para desenvolvimento local, False para produção)
DEBUG=True

# Hosts permitidos separados por vírgula (ex: localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1
